# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessions — random string, 32+ chars. Required in production.
SESSION_SECRET=

# Bootstrap admin: this email + CRM_PASSWORD always signs in as admin.
ADMIN_EMAIL=
CRM_PASSWORD=

# AI (daily brief, lead + dashboard summaries)
GROQ_API_KEY=

# WhatsApp (parked until Meta verification) — see WHATSAPP_INTEGRATION.md
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=lead_confirmation
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_REMINDER_HOURS=48
# Reminder sweep auth: Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=
WHATSAPP_CRON_SECRET=
